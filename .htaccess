# Misambi Medical Mission — Apache settings (works on most cPanel hosts)

# Friendly "page not found" page
ErrorDocument 404 /404.html

# Don't list folder contents
Options -Indexes

# --- Force HTTPS -----------------------------------------------------------
# Turn this on ONLY after SSL is active (cPanel > SSL/TLS Status > Run AutoSSL,
# and https://misambimedicalmission.org opens without a warning).
# To turn on: remove the # at the start of the three lines below.
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Cache images, CSS and JS for faster repeat visits
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
